generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // FIX: Added missing url required for introspection
}

// --- ENUMS ---
enum Role {
  DESIGNER
  CLIENT
}

enum ProjectStatus {
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

// --- MODELS ---
model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String  
  role         Role            @default(CLIENT)
  createdAt    DateTime        @default(now())
  
  projectsOwned Project[]       @relation("ProjectOwner")
  comments      Comment[]
  memberOf      ProjectMember[] 
  activityLogs  ActivityLog[]   // NEW: Forensic compliance relation
}

model Project {
  id                 String          @id @default(cuid())
  title              String
  description        String?
  status             ProjectStatus   @default(IN_REVIEW)
  inviteToken        String?         @unique 
  inviteTokenExpiresAt DateTime?       // NEW: Security constraint (7-day expiry)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  isArchived         Boolean         @default(false)
  isDownloadUnlocked Boolean         @default(false)
  
  ownerId            String
  owner              User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  
  assets             Asset[]
  members            ProjectMember[] 
  activityLogs       ActivityLog[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) 
  @@index([projectId]) // NEW: Performance index
  @@index([userId])    // NEW: Performance index
}

model Asset {
  id        String   @id @default(cuid())
  fileUrl   String
  fileName  String? 
  version   Int      @default(1)
  createdAt DateTime @default(now())
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@unique([projectId, fileName, version]) // NEW: Race Condition Backstop
  @@index([projectId]) // NEW: Performance index
}

model Comment {
  id         String   @id @default(cuid())
  text       String
  xPos       Float    
  yPos       Float    
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])

  @@index([assetId])  // NEW: Performance index
  @@index([authorId]) // NEW: Performance index
}

model ActivityLog {
  id        String   @id @default(cuid())
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId    String   // NEW: Relational link for forensic auditing
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action    String   
  details   String   
  createdAt DateTime @default(now())

  @@index([projectId]) // NEW: Performance index
  @@index([userId])    // NEW: Performance index
} // FIX: Moved closing brace to its own line