{
  "name": "final-frame-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "preinstall": "node scripts/verify-runtime.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/migrate-with-preflight.mjs",
    "db:migrate:rehearse": "node scripts/rehearse-migrations.mjs",
    "db:studio": "prisma studio",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "build": "npm run clean && npm run prisma:validate && npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "test": "npm run typecheck:core && npm run test:core",
    "check": "npm run lockfile:check && npm run prisma:validate && npm run typecheck && npm run test && npm run test:release-scripts",
    "release": "npm run db:migrate:deploy",
    "start:migrate": "npm run release && npm start",
    "verify": "npm run lockfile:check && npm audit --omit=dev && npm run prisma:validate && npm run typecheck && npm run test && npm run test:release-scripts && npm run build",
    "ops:storage-reconcile": "node --enable-source-maps dist/scripts/reconcile-storage.js",
    "ops:storage-reconcile:dev": "tsx src/scripts/reconcile-storage.ts",
    "ops:verify-evidence": "node --enable-source-maps dist/scripts/verify-evidence.js",
    "ops:verify-evidence:dev": "tsx src/scripts/verify-evidence.ts",
    "ops:dead-letter": "node --enable-source-maps dist/scripts/dead-letter.js",
    "ops:dead-letter:dev": "tsx src/scripts/dead-letter.ts",
    "ops:restore-drill": "node scripts/restore-drill.mjs",
    "ops:load-slo": "node scripts/load-slo.mjs",
    "ops:verify-deployed-security": "node scripts/verify-deployed-security.mjs",
    "lockfile:refresh": "node scripts/refresh-lockfile.mjs",
    "lockfile:check": "node scripts/verify-lockfile.mjs",
    "e2e:seed": "tsx src/scripts/seed-e2e.ts",
    "db:migrate:deploy:unsafe": "prisma migrate deploy",
    "test:release-scripts": "node --test scripts/*.test.mjs",
    "e2e:storage:prepare": "tsx src/scripts/prepare-e2e-storage.ts",
    "test:core": "node --experimental-strip-types --test src/config/*.test.ts src/services/*.test.ts",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1107.0",
    "@aws-sdk/s3-request-presigner": "3.1107.0",
    "@panva/hkdf": "1.2.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@socket.io/redis-streams-adapter": "0.3.1",
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "pg": "8.23.0",
    "proxy-addr": "2.0.7",
    "redis": "6.2.1",
    "resend": "6.19.0",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/pg": "8.21.0",
    "@types/proxy-addr": "2.0.3",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
