# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
HTTP_SLOW_REQUEST_MS=2000
SHUTDOWN_TIMEOUT_MS=75000
API_JSON_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
READINESS_TIMEOUT_MS=2000
BCRYPT_ROUNDS=12
PAGE_DEFAULT_SIZE=50
PAGE_MAX_SIZE=100
INVITE_TTL_HOURS=168
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
MFA_SETUP_TTL_MINUTES=10
MFA_ISSUER=FinalFrame
# Generate both values independently with a cryptographically secure password manager.
MFA_ENCRYPTION_KEY=replace_with_a_unique_random_secret_of_at_least_32_characters
MFA_RECOVERY_PEPPER=replace_with_a_different_random_secret_of_at_least_32_characters
UPLOAD_RESERVATION_TTL_MINUTES=15
MULTIPART_UPLOAD_THRESHOLD_BYTES=8388608
MULTIPART_UPLOAD_PART_SIZE_BYTES=8388608

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL / Prisma
# DATABASE_URL is used by the running API.
# DIRECT_DATABASE_URL is optional and may point to a direct, non-pooled endpoint
# for migrations when DATABASE_URL uses a connection pooler.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/finalframe
DIRECT_DATABASE_URL=
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=300000
DB_QUERY_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# Redis is required for production-wide rate limits and distributed realtime.
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_READINESS_TIMEOUT_MS=1500
REDIS_KEY_PREFIX=finalframe:

# ─────────────────────────────────────────────────────────────────────────────
# NextAuth v4 shared session settings
# These values must exactly match web/.env and the NextAuth cookie configuration.
# Development: next-auth.session-token
# HTTPS production: __Secure-next-auth.session-token
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=replace_with_at_least_32_random_characters
SESSION_COOKIE_NAME=next-auth.session-token

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2
# Store only object keys in the database. R2_PUBLIC_URL is optional and is used
# only to recognize legacy full URLs already stored in the database.
# ─────────────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=finalframe-assets
# Leave blank for Cloudflare R2. Set an HTTPS S3-compatible endpoint for private/test deployments.
R2_ENDPOINT=
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
R2_PUBLIC_URL=
R2_UPLOAD_URL_TTL_SECONDS=600
R2_VIEW_URL_TTL_SECONDS=900
MAX_ASSET_UPLOAD_BYTES=104857600
MAX_AUDIO_UPLOAD_BYTES=10485760
ASSET_PROCESSING_INTERVAL_MS=5000
ASSET_PROCESSING_BATCH_SIZE=2
ASSET_PROCESSING_TIMEOUT_MS=180000
ASSET_PROCESSING_STALE_MS=600000
ASSET_PREVIEW_MAX_TEXT_BYTES=2097152
ASSET_PREVIEW_MAX_BYTES=52428800
ASSET_IMAGE_MAX_PIXELS=50000000
ASSET_VIDEO_MAX_PIXELS=8847360
ASSET_VIDEO_MAX_DURATION_SECONDS=3600
ASSET_PDF_MAX_PAGES=500
# Optional local overrides for media-processing binaries. Production images install these tools on PATH.
ASSET_FFMPEG_PATH=
ASSET_FFPROBE_PATH=
ASSET_PDFINFO_PATH=
ASSET_GHOSTSCRIPT_PATH=
# Required in production. Use the private service hostname, not a public endpoint.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# Email
# Use disabled when no email provider is available. Sign-in, in-app notices,
# and one-time invite links still work. Email verification and reset links do not.
# Use resend only after setting both Resend values below.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_DELIVERY_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_OUTBOX_INTERVAL_MS=10000
EMAIL_OUTBOX_BATCH_SIZE=20

# ─────────────────────────────────────────────────────────────────────────────
# AI summary service
# Optional. The summary endpoint returns 503 when this is not configured.
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=25000
OPENROUTER_MAX_INPUT_CHARS=12000
OPENROUTER_MAX_OUTPUT_TOKENS=1500

# ─────────────────────────────────────────────────────────────────────────────
# Reliable R2 cleanup worker
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_CLEANUP_INTERVAL_MS=30000
STORAGE_CLEANUP_BATCH_SIZE=25
STORAGE_CLEANUP_LOCK_MS=300000
STORAGE_CLEANUP_MAX_ATTEMPTS=10
STORAGE_CLEANUP_MAX_BATCHES_PER_RUN=4
PROJECT_DELETION_INTERVAL_MS=5000
PROJECT_DELETION_BATCH_SIZE=10
RETENTION_CLEANUP_INTERVAL_MS=3600000
RETENTION_CLEANUP_BATCH_SIZE=100
NOTIFICATION_RETENTION_DAYS=180
TOKEN_RETENTION_DAYS=30

SESSION_REVALIDATION_INTERVAL_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# Account and service safeguards
# ─────────────────────────────────────────────────────────────────────────────
FREE_MAX_PROJECTS=10
GLOBAL_MAX_PROJECTS=100
FREE_MAX_PROJECT_MEMBERS=10
FREE_MAX_PENDING_INVITES=25
FREE_MAX_COMMENTS_PER_PROJECT=5000
FREE_MAX_STORAGE_BYTES=2147483648
GLOBAL_MAX_STORAGE_BYTES=8589934592
FREE_MAX_AI_REQUESTS_PER_MONTH=50

# ─────────────────────────────────────────────────────────────────────────────
# Socket.IO collaboration channel
# ─────────────────────────────────────────────────────────────────────────────
SOCKET_MAX_HTTP_BUFFER_BYTES=16384
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_AUTH_IP_ATTEMPTS_PER_MINUTE=300
SOCKET_AUTH_USER_ATTEMPTS_PER_MINUTE=60
SOCKET_MAX_CONNECTIONS_PER_IP=100
SOCKET_MAX_CONNECTIONS_PER_USER=10
SOCKET_JOIN_DEBOUNCE_MS=150
SOCKET_CURSOR_INTERVAL_MS=33
SOCKET_RECOVERY_MAX_DISCONNECTION_MS=120000
SOCKET_CONNECTION_LEASE_TTL_MS=90000
SOCKET_CONNECTION_LEASE_REFRESH_MS=30000

# Private metrics endpoint and approval-certificate integrity.
METRICS_BEARER_TOKEN=replace_with_a_unique_random_secret_of_at_least_32_characters
CERTIFICATE_SIGNING_KEY=replace_with_a_different_random_secret_of_at_least_48_characters
CERTIFICATE_KEY_ID=finalframe-ed25519-v1
# Keep retired public keys here during signing-key rotation, for example:
# CERTIFICATE_TRUSTED_PUBLIC_KEYS_JSON={"finalframe-ed25519-v0":"base64url-public-key"}
CERTIFICATE_TRUSTED_PUBLIC_KEYS_JSON={}
STORAGE_RECONCILIATION_MAX_OBJECTS=100000
STORAGE_RECONCILIATION_ORPHAN_GRACE_HOURS=24

# Migration-container safety gate. These are consumed only by the migration
# image, not by the long-running API process.
BACKUP_RESTORE_TESTED=false
BACKUP_RESTORE_VERIFIED_AT=
BACKUP_MAX_AGE_HOURS=24
MIGRATION_CONFIRM_DATABASE=localhost:5432/finalframe
