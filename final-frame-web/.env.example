# -----------------------------------------------------------------------------
# FinalFrame web application — local development
# Copy this file to .env.local. Never commit .env.local or real secrets.
# -----------------------------------------------------------------------------

# Explicit deployment tier. Keep development even when testing `next build`
# locally. NODE_ENV is controlled by Next.js and is not a deployment-tier flag.
DEPLOYMENT_ENVIRONMENT=development

# Browser-visible URLs. NEXT_PUBLIC_* values are embedded into the browser
# bundle and must never contain secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
# Exact origin used by presigned upload and review URLs. Do not include a path.
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com
# Local MinIO example: http://localhost:9000
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000
NEXT_PUBLIC_SITE_NAME=FinalFrame

# Use the same release identifier on the browser and server. `local` is valid for
# local development. Production should use a unique Git commit SHA or release ID.
NEXT_PUBLIC_RELEASE_VERSION=local
RELEASE_VERSION=local

# Privacy-conscious first-party telemetry. The browser sends only Web Vitals,
# sanitized errors, route paths without query strings, and the release ID to the
# local /api/telemetry route. No user content or account identifiers are sent.
NEXT_PUBLIC_TELEMETRY_ENABLED=true
NEXT_PUBLIC_TELEMETRY_SAMPLE_RATE=1

# Server-side URL used by the NextAuth Credentials provider. In production this
# may be a private/internal API URL if the hosting platform provides one.
API_URL=http://localhost:5000

# NextAuth v4. NEXTAUTH_SECRET must exactly match the backend NEXTAUTH_SECRET.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_the_same_32_plus_character_secret_used_by_the_api

# HTTP local development: next-auth.session-token
# HTTPS production: __Secure-next-auth.session-token
SESSION_COOKIE_NAME=next-auth.session-token

# HSTS defaults to the current host only. Do not enable subdomain or preload
# scope until every subdomain is permanently HTTPS-controlled and reviewed.
HSTS_SCOPE=host
HSTS_MAX_AGE_SECONDS=15552000
HSTS_DOMAIN_CONTROL_CONFIRMED=false

# Optional private observability forwarding. When absent, sanitized telemetry is
# written as structured logs when OBSERVABILITY_LOG_TO_STDOUT=true.
OBSERVABILITY_ENDPOINT=
OBSERVABILITY_TOKEN=
OBSERVABILITY_LOG_TO_STDOUT=true
TELEMETRY_MAX_BODY_BYTES=16384

# Optional search-engine ownership verification. Leave blank until the real
# production domain is registered with each service.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional authenticated end-to-end test account. Keep mutation tests disabled
# unless the account uses a disposable development database.
E2E_EMAIL=
E2E_PASSWORD=
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
E2E_ALLOW_MUTATIONS=false
