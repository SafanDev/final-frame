{
  "name": "final-frame-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "preinstall": "node scripts/verify-runtime.mjs",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && next build",
    "start": "next start",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "verify": "npm run lockfile:check && npm run security:audit && npm run env:check && npm run check && npm run build && npm run performance:budget",
    "lockfile:init": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "lockfile:check": "node scripts/verify-lockfile.mjs",
    "lint": "eslint . --max-warnings=0",
    "test:watch": "vitest",
    "test:coverage": "npm run test:coverage:report && npm run test:coverage:critical",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:browsers:install": "playwright install chromium firefox webkit",
    "analyze": "next experimental-analyze --output",
    "lighthouse": "npm run lighthouse:desktop && npm run lighthouse:mobile",
    "env:check": "node scripts/validate-environment.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "verify:full": "npm run verify && npm run test:e2e && npm run lighthouse",
    "ci": "npm run lockfile:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run performance:budget && npm run test:e2e && npm run lighthouse",
    "performance:budget": "node scripts/check-bundle-budget.mjs",
    "test:coverage:report": "vitest run --coverage --config vitest.config.mts",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical.config.mts",
    "lighthouse:desktop": "lhci autorun --config=.lighthouserc.cjs",
    "lighthouse:mobile": "lhci autorun --config=.lighthouserc.mobile.cjs"
  },
  "dependencies": {
    "framer-motion": "13.1.1",
    "next": "16.3.3",
    "next-auth": "4.24.15",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "10.5.0",
    "react-syntax-highlighter": "16.1.1",
    "socket.io-client": "4.8.3",
    "sonner": "2.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.3"
    },
    "postcss": "8.5.23"
  }
}
