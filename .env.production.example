# FinalFrame production Compose variables
#
# Copy this file to .env.production and replace every placeholder:
#   Copy-Item .env.production.example .env.production
#
# Run Compose with:
#   docker compose --env-file .env.production -f docker-compose.production.example.yml config
#
# API runtime secrets, Neon URLs, R2 credentials, email credentials and
# signing keys belong in final-frame-api/.env.production, which is also ignored.

# Public application routing
PUBLIC_SITE_URL=https://app.example.com
PUBLIC_API_URL=https://app.example.com/backend
PUBLIC_STORAGE_ORIGIN=https://account-id.r2.cloudflarestorage.com
APP_DOMAIN=app.example.com
ACME_EMAIL=operations@example.com

# Release images and version
FINALFRAME_API_IMAGE=finalframe-api:replace-with-git-sha
FINALFRAME_WEB_IMAGE=finalframe-web:replace-with-git-sha
RELEASE_VERSION=replace-with-git-sha

# Shared infrastructure secrets
REDIS_PASSWORD=replace_with_a_unique_high_entropy_secret
NEXTAUTH_SECRET=replace_with_at_least_32_random_characters
LB_COOKIE_SECRET=replace_with_a_different_high_entropy_secret

# HTTPS policy
HSTS_SCOPE=host
HSTS_MAX_AGE_SECONDS=15552000
HSTS_DOMAIN_CONTROL_CONFIRMED=false

# Migration safety gate
# Leave these safe defaults unchanged during normal application startup.
# Set them only immediately before an independently verified migration run.
BACKUP_RESTORE_TESTED=false
BACKUP_RESTORE_VERIFIED_AT=
BACKUP_MAX_AGE_HOURS=24
MIGRATION_CONFIRM_DATABASE=